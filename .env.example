DATABASE_URL="postgresql://horus:horus_dev_password@localhost:5432/fvf_horus?schema=public"

# --- PgBouncer (transaction pooling, opcional) ---
# Container fvf-horus-pgbouncer (infra/docker-compose.dev.yml) já sobe
# na porta 6432, transaction pooling na frente do Postgres. Pra ligar
# de verdade (pool de conexões real em vez do pool interno do Prisma
# sozinho), troque a DATABASE_URL acima por esta, com
# "?pgbouncer=true" (desliga prepared statements , obrigatório em modo
# transaction) , SEMPRE rode `prisma migrate` contra a porta 5432
# direto, nunca contra a 6432 (migrations precisam de conexão de
# sessão, não de transação):
# DATABASE_URL="postgresql://horus:horus_dev_password@localhost:6432/fvf_horus?schema=public&pgbouncer=true"
# Em produção, com mais de uma instância do backend rodando (escala
# horizontal), considere acrescentar parâmetros de pool na própria URL ,
# ex.: "...fvf_horus?schema=public&connection_limit=20&pool_timeout=10"
# , connection_limit é o teto de conexões do Prisma POR INSTÂNCIA: se
# você rodar 4 instâncias com connection_limit=20, o Postgres precisa
# aceitar pelo menos 80 conexões simultâneas (confira max_connections do
# Postgres). Pra números maiores que isso, o caminho recomendado é somar
# um PgBouncer (transaction pooling) entre a aplicação e o Postgres, em
# vez de só aumentar o connection_limit , evita esgotar a memória do
# Postgres com muitas conexões idle.

# --- Seguranca (arquitetura bancaria de controle de jornada) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTO_MASTER_KEY=
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SEGUNDOS=900
# Painel do gestor (UsuarioEmpresa): sessão fica válida enquanto o
# usuário continuar ativo pelo menos uma vez dentro dessa janela , cada
# refresh recalcula "agora + N horas". Só expira de verdade depois de N
# horas SEM nenhuma chamada à API (Rodada 65).
JWT_INATIVIDADE_MAX_HORAS=5
# Super admin da plataforma , continua com um prazo fixo em dias desde o
# último login/refresh (não é o painel do gestor, não mudou na Rodada 65).
JWT_REFRESH_TTL_DIAS=7
CORS_ORIGINS=http://localhost:5173,https://seu-projeto.vercel.app

PORT=3000

# --- Bootstrap (npx prisma db seed) ---
# Opcionais , sem preencher, o seed usa valores padrão (ver
# console.log ao final do script para a senha gerada). Ajuste antes de
# rodar em qualquer ambiente que não seja sua máquina local.
# SEED_ADMIN_EMAIL / SEED_ADMIN_SENHA: primeiro ADMIN de um grupo demo.
# SEED_SUPER_ADMIN_EMAIL / SEED_SUPER_ADMIN_SENHA (Rodada 31): dono da
# plataforma , é quem provisiona todos os próximos clientes pelo
# painel de super admin (POST /super-admin/grupos), sem precisar rodar
# este script de novo.
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_SENHA=

# --- Notificações push (Expo) via fila BullMQ/Redis ---
# Em dev, use o Redis do docker-compose (infra/docker-compose.dev.yml).
# Em produção na Hostinger, aponte para o Redis daquela VPS.
REDIS_HOST=localhost
REDIS_PORT=6379
# Opcional: senha do Redis (Easypanel e outros serviços gerenciados criam com senha).
# Em dev local (docker-compose) fica vazio.
REDIS_PASSWORD=

# Quantos lotes de ponto (POST /registros-jornada/lote) o worker
# processa ao mesmo tempo (Rodada 66) , o resto espera na fila em vez
# de sobrecarregar o Postgres quando muitos motoristas mandam lote ao
# mesmo tempo (ex.: saindo de uma área sem sinal juntos). Sem Redis
# disponível, cada requisição cai no fallback síncrono automaticamente
# (fail-open), sem depender desta variável.
CONCORRENCIA_FILA_LOTE_PONTO=10

# --- Object storage (Cloudflare R2) para XML de CT-e/MDF-e ---
# Opcional: sem preencher, o XML continua sendo guardado no Postgres
# (comportamento de sempre, funciona sem nenhuma conta nova). Preenchendo,
# os uploads passam a ir pro bucket R2 automaticamente , sem custo de
# egress da Cloudflare e sem inflar o banco com arquivo binário.
# R2_ENDPOINT: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- WhatsApp via Evolution API (opcional, fail-open; tem prioridade) ---
# Instância própria no Easypanel (texto livre, sem template). URL interna
# do Easypanel (ex.: http://evolution-api:8080) ou a pública com https.
# A chave é a AUTHENTICATION_API_KEY do serviço Evolution; a instância
# é o nome criado e conectado por QR Code. Preencher só no Easypanel.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# --- WhatsApp Business Cloud API (opcional, fail-open) ---
# Sem essas 3 variáveis, o serviço de notificação por WhatsApp
# simplesmente não enfileira nada , nenhum outro comportamento do app
# muda. Gerar em https://developers.facebook.com/apps (WhatsApp > API Setup).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nome do template pré-aprovado no WhatsApp Manager (obrigatório fora da
# janela de 24h de conversa com o destinatário).
WHATSAPP_TEMPLATE_NOME=fvf_horus_alerta_critico

# --- Geocodificação (cerca virtual da entrega) ---
# LIGADA POR PADRÃO, sem nenhuma variável pra preencher: usa o serviço
# público e gratuito do Nominatim (OpenStreetMap) pra resolver o
# endereço do destinatário do CT-e (extraído do XML) em coordenadas,
# e comparar com o GPS do motorista em "Fim de descarregamento" (cerca
# de 500m). Nunca bloqueia nada , só gera um alerta pro gestor revisar.
# GEOCODING_DESATIVADO=true desliga o recurso inteiro (ex.: ambiente
# de teste sem rede externa); GEOCODING_API_URL aponta pra outro
# serviço compatível com a API do Nominatim (ex.: instância própria,
# se o rate-limit público de 1 req/s incomodar em produção).
GEOCODING_DESATIVADO=
GEOCODING_API_URL=
GEOCODING_USER_AGENT=
GEOCODING_TIMEOUT_MS=

# A cada quanto tempo (em ms) o backend varre motoristas com jornada
# aberta pra reavaliar os limites legais (direção contínua/jornada de
# direção/espera) mesmo sem nenhum evento novo registrado , Rodada 19.
# Decisão explícita (Rodada 20): o cálculo fica só no servidor, não no
# app do motorista, pra não gastar bateria do telefone; por isso o
# padrão é 1800000 (30min) e não algo mais curto , se precisar de mais
# reação, reduza aqui, mas lembre que cada ciclo varre TODOS os
# motoristas com jornada aberta.
# Opcional, padrão 1800000 (30min) se não preenchido.
INTERVALO_VERIFICACAO_JORNADA_ABERTA_MS=
# Rodada 165: intervalo da varredura automática da cadeia de hashes (ms). Padrão 3600000 (1h).
INTERVALO_VERIFICACAO_INTEGRIDADE_MS=

# --- E-mail transacional (recuperação de senha , Rodada 33) ---
# FAIL-OPEN por padrão: sem RESEND_API_KEY, o link de recuperação de
# senha é apenas logado no console do backend (com um aviso "MODO
# SIMULADO"), em vez de enviado por e-mail de verdade , útil pra dev
# e testes sem depender de conta em nenhum provedor. Pra envio real,
# crie uma conta na Resend (https://resend.com), gere uma API key e
# valide um domínio de envio (ou use o domínio de teste deles,
# onboarding@resend.dev, só pra testar).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# URL pública do painel web (usada para montar o link clicável nos
# e-mails de recuperação de senha, ex.: FRONTEND_URL/redefinir-senha).
# Opcional, padrão http://localhost:5173 se não preenchido.
FRONTEND_URL=

# --- Rodada 165: chave do dispositivo e limite das rotas do app ---
# Segredo ("pepper") do HMAC que protege o hash da chave do dispositivo.
# 32+ caracteres aleatórios. Se vazio, deriva de CRYPTO_MASTER_KEY.
# NÃO troque depois de emitir chaves (os aparelhos teriam que vincular de novo).
DEVICE_KEY_PEPPER=
# Máximo de requisições por aparelho autenticado por minuto (padrão 120).
DEVICE_RATE_LIMIT_PER_MIN=
